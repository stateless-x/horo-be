PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/horo

# OAuth Base URL (for auth callbacks)
# IMPORTANT: Must include https:// protocol in production!
# Local: OAUTH_BASE_URL=http://localhost:3001
# Production: OAUTH_BASE_URL=https://api-horo.up.railway.app
OAUTH_BASE_URL=http://localhost:3001

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# X (Twitter) OAuth 2.0
# Get from: https://developer.x.com/en/portal/dashboard
# IMPORTANT: You must enable "User authentication settings" in your X app first!
# If you only see Consumer Keys, you haven't enabled OAuth 2.0 yet.
# Steps: App Settings → User authentication settings → Set up → Choose "Web App" + "Confidential"
# Then go to Keys and Tokens tab to find Client ID and Client Secret
TWITTER_CLIENT_ID=your-x-oauth2-client-id
TWITTER_CLIENT_SECRET=your-x-oauth2-client-secret

# DeepSeek API
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated list of allowed origins)
# Example: http://localhost:3000,https://example.com,https://app.example.com
# International domains (Thai, etc.) work in either format:
#   - https://สายมู.com (Thai) - automatically includes punycode version
#   - https://xn--y3cbx6azb.com (punycode) - automatically includes Thai version
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Campaign email (scripts/send-campaign.ts) ---
# Resend API key. Feature-scoped: a missing key degrades campaign sending ONLY
# and must never be added to config.ts `authRequired` (see the scar comment there).
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain VERIFIED in Resend (DNS SPF/DKIM). A personal
# mailbox you don't control the DNS for (e.g. @pm.me) can never go here.
EMAIL_FROM=ภู จากสายมู <horo@mail.pooh.fyi>
# Where replies go. Any address — no verification needed.
EMAIL_REPLY_TO=askpurin@pm.me
# Per-day send quota of your Resend plan (free tier: 100).
EMAIL_DAILY_CAP=100
# FALLBACK ONLY. Normally the script asks Resend how many emails the whole
# account sent today (covering Pawjai and any other site on the same key) and
# subtracts that, so no estimate is needed. This reserve is used only when that
# API call fails — set it to roughly what the other sites send per day.
EMAIL_DAILY_RESERVE=20
# Optional; falls back to BETTER_AUTH_SECRET if unset.
EMAIL_UNSUBSCRIBE_SECRET=
